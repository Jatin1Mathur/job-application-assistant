# Copy this file to .env and set your own values. .env is never committed.
# docker compose reads .env by itself; so does the backend when you start it with ./mvnw spring-boot:run.

# Password of the PostgreSQL user "jobuser". Used by the database container and by the backend.
POSTGRES_PASSWORD=change-me

# Signs the login tokens (JWT). Use a long random value, at least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters

# ----- Optional. The lines below show the defaults; remove the # to change one. -----

# Where the backend container finds Ollama. The default is your own machine.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# The AI model Ollama should use
# OLLAMA_MODEL=llama3.2

# The port of the app in your browser: http://localhost:3000
# FRONTEND_PORT=3000
